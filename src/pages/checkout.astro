---
/**
 * checkout.astro — Solicitud de cotización segura.
 *
 * Este flujo no procesa pagos. Solo acepta SKU públicos, vuelve a consultar el
 * catálogo canónico y prepara una solicitud por WhatsApp. Los cobros se
 * habilitarán cuando exista un proveedor transaccional validado en servidor.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Solicitar cotización — RCP Services"
  description="Revisa los servicios seleccionados y solicita una cotización formal de RCP Services."
  canonical="/checkout"
  active="checkout"
  requiresSupabase={true}
  robots="noindex, nofollow, noarchive"
>
  <main>
    <section class="hero hero-short" id="inicio">
      <div class="hero-bg-grid"></div>
      <div class="container quote-hero">
        <div class="hero-content">
          <div class="hero-badge animate-fade-up"><span class="badge-dot"></span> Solicitud protegida</div>
          <h1 class="hero-title animate-fade-up delay-1">Solicita tu <span class="accent">cotización formal</span></h1>
          <p class="hero-sub animate-fade-up delay-2">
            Confirmaremos alcance, disponibilidad, precio e impuestos antes de emitir una orden o solicitar cualquier pago.
          </p>
        </div>
      </div>
    </section>

    <section class="section quote-section">
      <div class="container quote-layout">
        <form id="quoteForm" class="contacto-section-card quote-form">
          <h2>Datos de contacto</h2>
          <p class="quote-note">Estos datos se usan únicamente para preparar tu solicitud en WhatsApp; no se guardan en este sitio.</p>
          <div class="form-row">
            <div class="form-group">
              <label for="quoteName">Nombre completo</label>
              <input id="quoteName" class="form-control" required maxlength="120" autocomplete="name" />
            </div>
            <div class="form-group">
              <label for="quoteCompany">Empresa</label>
              <input id="quoteCompany" class="form-control" required maxlength="160" autocomplete="organization" />
            </div>
          </div>
          <div class="form-row">
            <div class="form-group">
              <label for="quoteEmail">Correo electrónico</label>
              <input id="quoteEmail" type="email" class="form-control" required maxlength="180" autocomplete="email" />
            </div>
            <div class="form-group">
              <label for="quotePhone">Teléfono</label>
              <input id="quotePhone" type="tel" class="form-control" required maxlength="40" autocomplete="tel" />
            </div>
          </div>
          <div class="form-group">
            <label for="quoteDetails">Necesidad o alcance</label>
            <textarea id="quoteDetails" class="form-control" rows="5" maxlength="1200" placeholder="Cantidad, fecha objetivo, funcionalidades o especificaciones necesarias"></textarea>
          </div>
          <label class="consent-row">
            <input id="quoteConsent" type="checkbox" required />
            <span>Acepto iniciar esta conversación por WhatsApp y que RCP Services use estos datos para responder mi solicitud.</span>
          </label>
          <button id="quoteSubmit" class="btn-cta btn-full btn-lg" type="submit" disabled>Continuar por WhatsApp</button>
          <p id="quoteStatus" class="quote-status" role="status" aria-live="polite">Validando selección con el catálogo oficial…</p>
        </form>

        <aside class="checkout-summary-card">
          <h2>Servicios seleccionados</h2>
          <div id="quoteItems" class="summary-items-list"></div>
          <div class="quote-total">
            <span>Referencia estimada</span>
            <strong id="quoteTotal">Pendiente</strong>
          </div>
          <p class="quote-disclaimer">
            Los importes mostrados son referencias del catálogo vigente, no constituyen una oferta final ni un cargo. RCP Services confirmará el total por escrito.
          </p>
          <a class="btn-ghost btn-full" href="/tienda">Volver al catálogo</a>
        </aside>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .quote-hero { position:relative; width:100%; padding-top:120px; }
  .quote-section { padding-top:48px; }
  .quote-layout { display:grid; grid-template-columns:1.45fr 1fr; gap:30px; align-items:start; }
  .quote-form { padding:30px; }
  .quote-form h2, .checkout-summary-card h2 { margin-bottom:12px; font-size:1.35rem; font-weight:800; }
  .quote-note, .quote-disclaimer, .quote-status { color:var(--text-muted); font-size:.82rem; line-height:1.55; }
  .quote-note { margin-bottom:22px; }
  .consent-row { display:flex; gap:10px; align-items:flex-start; margin:20px 0; color:var(--text-muted); font-size:.82rem; line-height:1.5; }
  .consent-row input { margin-top:3px; }
  .quote-status { margin-top:12px; text-align:center; }
  .checkout-summary-card { background:var(--card-bg); border:1px solid var(--card-border); border-radius:var(--radius); padding:30px 24px; position:sticky; top:100px; }
  :global(.summary-item) { display:flex; justify-content:space-between; gap:18px; padding:13px 0; border-bottom:1px solid var(--card-border); font-size:.86rem; }
  :global(.summary-item-name) { color:var(--text); }
  :global(.summary-item-price) { color:var(--accent); font-weight:700; white-space:nowrap; }
  .quote-total { display:flex; justify-content:space-between; gap:12px; margin:20px 0 12px; font-size:.95rem; }
  .quote-total strong { color:var(--accent); }
  .quote-disclaimer { margin-bottom:18px; }
  .btn-full { width:100%; justify-content:center; text-align:center; }
  @media (max-width:900px) { .quote-layout { grid-template-columns:1fr; } .checkout-summary-card { position:static; } }
  @media (max-width:600px) {
    :global(.chatbot-widget),
    :global(.chat-panel) { display:none !important; }
  }
</style>

<script>
  (function () {
    const WA_NUMBER = '18298068092';
    const isLocal = new URLSearchParams(window.location.search).get('local_db') === '1';
    const supabaseUrl = isLocal ? 'http://127.0.0.1:54321' : 'https://wpfovxgbennpgydbellw.supabase.co';
    const supabaseKey = isLocal ? 'sb_publishable_ACJWlzQHlZjBrEguHvfOxg_3BJgxAaH' : 'sb_publishable_wQHzaXkyhbfuOdDkMAWAKQ_VOE14bfO';
    const allowedSku = /^[A-Z0-9-]{2,40}$/;
    const requestedSkus = [...new Set((new URLSearchParams(location.search).get('items') || '')
      .split(',').map((sku) => sku.trim().toUpperCase()).filter((sku) => allowedSku.test(sku)))].slice(0, 20);

    const form = document.getElementById('quoteForm') as HTMLFormElement;
    const submit = document.getElementById('quoteSubmit') as HTMLButtonElement;
    const status = document.getElementById('quoteStatus')!;
    const list = document.getElementById('quoteItems')!;
    const total = document.getElementById('quoteTotal')!;
    let verifiedItems: any[] = [];

    const formatPrice = (item: any) => {
      if (item.requires_quote || Number(item.price_min) <= 0) return 'Cotizar';
      const setup = Number(item.precio_inicial || item.price_min || 0);
      const recurring = Number(item.precio_recurrente || 0);
      if (setup > 0 && recurring > 0) return `RD$ ${setup.toLocaleString()} + RD$ ${recurring.toLocaleString()}/mes`;
      if (recurring > 0) return `RD$ ${recurring.toLocaleString()}/mes`;
      return `Desde RD$ ${setup.toLocaleString()}`;
    };

    function renderItems() {
      list.innerHTML = '';
      verifiedItems.forEach((item) => {
        const row = document.createElement('div');
        row.className = 'summary-item';
        const name = document.createElement('span');
        name.className = 'summary-item-name';
        name.textContent = item.name_es;
        const price = document.createElement('span');
        price.className = 'summary-item-price';
        price.textContent = formatPrice(item);
        row.append(name, price);
        list.appendChild(row);
      });
      const fixed = verifiedItems.filter((item) => !item.requires_quote && Number(item.price_min) > 0);
      const minimum = fixed.reduce((sum, item) => sum + Number(item.precio_inicial || item.price_min || 0), 0);
      total.textContent = minimum > 0 ? `Desde RD$ ${minimum.toLocaleString()}` : 'A cotizar';
    }

    async function loadSelection() {
      if (!requestedSkus.length) {
        list.innerHTML = '<p class="quote-note">No hay servicios seleccionados.</p>';
        status.textContent = 'Selecciona al menos un servicio desde el catálogo.';
        return;
      }
      try {
        const filter = encodeURIComponent(`(${requestedSkus.join(',')})`);
        const url = `${supabaseUrl}/rest/v1/productos?sku=in.${filter}&is_active=eq.true&select=sku,name_es,price_min,requires_quote,precio_inicial,precio_recurrente`;
        const response = await fetch(url, { headers: { apikey: supabaseKey, Authorization: `Bearer ${supabaseKey}` } });
        if (!response.ok) throw new Error(`HTTP ${response.status}`);
        const products = await response.json();
        verifiedItems = requestedSkus.map((sku) => products.find((item: any) => item.sku === sku)).filter(Boolean);
        if (!verifiedItems.length) throw new Error('No verified products');
        renderItems();
        submit.disabled = false;
        status.textContent = verifiedItems.length === requestedSkus.length
          ? 'Selección validada con el catálogo oficial.'
          : 'Se omitieron referencias inexistentes o inactivas.';
      } catch (error) {
        console.error('[Quote] Catalog validation failed:', error);
        list.innerHTML = '<p class="quote-note">No pudimos validar el catálogo en este momento.</p>';
        status.textContent = 'La solicitud permanece deshabilitada para evitar precios incorrectos. Intenta nuevamente.';
      }
    }

    form.addEventListener('submit', (event) => {
      event.preventDefault();
      if (!form.reportValidity() || !verifiedItems.length) return;
      const value = (id: string) => (document.getElementById(id) as HTMLInputElement | HTMLTextAreaElement).value.trim();
      const itemLines = verifiedItems.map((item) => `- ${item.name_es} (${item.sku})`).join('\n');
      const message = [
        'Hola RCP Services. Solicito una cotización formal.', '',
        `Nombre: ${value('quoteName')}`, `Empresa: ${value('quoteCompany')}`,
        `Correo: ${value('quoteEmail')}`, `Teléfono: ${value('quotePhone')}`, '',
        'Servicios:', itemLines, '', `Alcance: ${value('quoteDetails') || 'Por definir'}`
      ].join('\n');
      window.open(`https://wa.me/${WA_NUMBER}?text=${encodeURIComponent(message)}`, '_blank', 'noopener,noreferrer');
      status.textContent = 'WhatsApp se abrió con tu solicitud preparada. Verifica el contenido antes de enviarlo.';
    });

    loadSelection();
  })();
</script>
