{
  "name": "rcp-services-web",
  "type": "module",
  "version": "6.0.0-rc.2",
  "private": true,
  "packageManager": "pnpm@11.16.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "description": "RCP Services — empresa de transformación para pequeños negocios: Renovación, Consultoría y Publicidad con tecnología transversal.",
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "build:cloudflare": "opennextjs-cloudflare build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests-next/*.test.mjs",
    "lint:pulso": "eslint --config eslint.pulso.config.mjs components/pulso-help.tsx components/pulso-question.tsx lib/pulso-*.ts proxy.ts workers/pulso/*.ts scripts/pulso-*.mjs",
    "test:pulso:browser": "node scripts/pulso-browser.mjs",
    "test:pulso:sqlite": "wrangler deploy --dry-run --config workers/pulso/wrangler.jsonc --outdir ../../tmp/pulso-bundle && node scripts/pulso-sqlite.mjs",
    "check": "pnpm run typecheck && pnpm run lint:pulso && node scripts/pulso-knowledge.mjs --check && pnpm test && pnpm run build",
    "preview": "pnpm run build:cloudflare && opennextjs-cloudflare preview",
    "deploy": "pnpm dlx vercel@latest deploy",
    "deploy:cloudflare": "pnpm run build:cloudflare && opennextjs-cloudflare deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "dependencies": {
    "next": "16.3.8",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@opennextjs/cloudflare": "latest",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@typescript/native": "npm:typescript@7.0.2",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "playwright": "1.63.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.71.1",
    "wrangler": "latest"
  }
}
