# Public and safe at build time
NEXT_PUBLIC_SITE_URL=http://localhost:3000
RCP_DEPLOYMENT_ENV=development

# Pulso: disabled until Workers Free + model access are verified and activation approved.
# Public URL only; no API credential or private conversation in the browser.
# Leave empty for an entirely local guide. No new Vercel API function is used.
NEXT_PUBLIC_PULSO_WORKER_URL=

# Pilot source of truth: email. Switch to crm only after the secured CRM intake is live.
RCP_INTAKE_DELIVERY_MODE=email

# Server-only CRM ingestion. Leave empty until the security hold is cleared.
RCP_CRM_INGEST_URL=
RCP_CRM_INGEST_TOKEN=
RCP_CRM_HMAC_SECRET=

# Server-only Specialist Network ingestion. Success requires an explicit CRM record confirmation.
RCP_CRM_SPECIALIST_INGEST_URL=
RCP_CRM_SPECIALIST_INGEST_TOKEN=
RCP_CRM_SPECIALIST_HMAC_SECRET=

# Optional Cloudflare Turnstile. Enable only when both keys are configured.
RCP_REQUIRE_TURNSTILE=false
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Optional server-side inquiry notification through Resend.
RESEND_API_KEY=
RCP_INQUIRY_EMAIL_FROM=
RCP_INQUIRY_EMAIL_TO=
RCP_SPECIALIST_EMAIL_TO=
